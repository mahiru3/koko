{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-z0-9-]{4,40}$/)",
        "meta": {
          ".write": "auth != null"
        },
        "assets": {
          "$asset": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/')"
          }
        },
        "chars": {
          ".write": "auth != null"
        },
        "items": {
          ".write": "auth != null"
        },
        "markers": {
          ".write": "auth != null"
        },
        "scenes": {
          ".write": "auth != null"
        },
        "notes": {
          ".write": "auth != null"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "messages": {
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('name').val().length <= 60 && newData.child('t').val() <= now"
          }
        }
      }
    }
  }
}
