{
  // koko rules v4f 2026-11-26
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-z0-9-]{4,40}$/)",
        ".write": "auth != null && !newData.exists() && data.child('meta/owner').exists() && data.child('meta/owner').val() === root.child('links/' + auth.uid + '/pid').val()",
        "meta": {
          "owner": {
            ".write": "auth != null && !data.exists() && newData.val() === root.child('links/' + auth.uid + '/pid').val()"
          },
          "kps": {
            ".write": "auth != null && root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val()"
          },
          "$other": {
            ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true))"
          }
        },
        "assets": {
          ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true))",
          "$asset": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/')"
          }
        },
        "chars": {
          ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true))",
          "$cid": {
            ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === root.child('links/' + auth.uid + '/pid').val()) || (data.child('owner').val() === root.child('links/' + auth.uid + '/pid').val() && (!newData.exists() || newData.child('owner').val() === root.child('links/' + auth.uid + '/pid').val())))",
            "x": {
              ".write": "auth != null && data.parent().exists()",
              ".validate": "newData.isNumber()"
            },
            "y": {
              ".write": "auth != null && data.parent().exists()",
              ".validate": "newData.isNumber()"
            }
          }
        },
        "items": {
          ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true))"
        },
        "markers": {
          ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true))"
        },
        "scenes": {
          ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true))"
        },
        "notes": {
          ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true))"
        },
        "effects": {
          ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true))"
        },
        "players": {
          "$pid": {
            ".write": "auth != null && ($pid === root.child('links/' + auth.uid + '/pid').val() || (auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true)))",
            ".validate": "!newData.exists() || (newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 60)"
          }
        },
        "kick": {
          "$pid": {
            ".write": "(auth != null && (root.child('rooms/' + $room + '/meta/owner').val() === root.child('links/' + auth.uid + '/pid').val() || root.child('rooms/' + $room + '/meta/kps/' + root.child('links/' + auth.uid + '/pid').val()).val() === true)) || (auth != null && $pid === root.child('links/' + auth.uid + '/pid').val() && !newData.exists())"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "messages": {
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('name').val().length <= 60 && newData.child('t').val() <= now"
          }
        }
      }
    },
    "profileCodes": {
      "$pid": {
        ".read": false,
        ".write": "auth != null && !data.exists() && $pid.matches(/^[a-z0-9]{8,24}$/)",
        ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
      }
    },
    "links": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['pid', 'code']) && root.child('profileCodes/' + newData.child('pid').val()).val() === newData.child('code').val()"
      }
    },
    "lib": {
      "$pid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('links/' + auth.uid + '/pid').val() === $pid",
        "files": {
          "$f": {
            ".validate": "!newData.exists() || (newData.child('data').isString() && newData.child('data').val().length <= 400000 && newData.child('data').val().beginsWith('data:image/'))"
          }
        }
      }
    }
  }
}