{
  // koko rules v4a 2026-11-25
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-z0-9-]{4,40}$/)",
        ".write": "auth != null && !newData.exists() && data.child('meta/owner').exists() && data.child('meta/owner').val() === root.child('links/' + auth.uid + '/pid').val()",
        "meta": {
          ".write": "auth != null"
        },
        "assets": {
          "$asset": {
            ".write": "auth != null",
            ".validate": "newData.isString() && newData.val().length <= 400000 && newData.val().beginsWith('data:image/')"
          }
        },
        "chars": {
          ".write": "auth != null"
        },
        "items": {
          ".write": "auth != null"
        },
        "markers": {
          ".write": "auth != null"
        },
        "scenes": {
          ".write": "auth != null"
        },
        "notes": {
          ".write": "auth != null"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "messages": {
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('name').val().length <= 60 && newData.child('t').val() <= now"
          }
        }
      }
    },
    "profileCodes": {
      "$pid": {
        ".read": false,
        ".write": "auth != null && !data.exists() && $pid.matches(/^[a-z0-9]{8,24}$/)",
        ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
      }
    },
    "links": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['pid', 'code']) && root.child('profileCodes/' + newData.child('pid').val()).val() === newData.child('code').val()"
      }
    },
    "lib": {
      "$pid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('links/' + auth.uid + '/pid').val() === $pid",
        "files": {
          "$f": {
            ".validate": "!newData.exists() || (newData.child('data').isString() && newData.child('data').val().length <= 400000 && newData.child('data').val().beginsWith('data:image/'))"
          }
        }
      }
    }
  }
}